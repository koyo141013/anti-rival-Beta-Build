					local constructingWeapon = nil
					local viewingProfile = nil
					local lastUsedWeapon = nil

					local function cloneCosmetic(name, cosmeticType, options)
						if type(name) ~= "string" or name == "" or name == "None" then
							return nil
						end
						local base = CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[name]
						if type(base) ~= "table" then
							return nil
						end
						local data = {}
						for k, v in pairs(base) do
							data[k] = v
						end
						data.Name = name
						data.Type = data.Type or cosmeticType
						if type(data.Seed) ~= "number" then
							data.Seed = math.random(1, 1000000)
						end
						if EnumLibrary and EnumLibrary.ToEnum then
							local s, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
							if s and enumId ~= nil then
								data.Enum = enumId
								if data.ObjectID == nil then
									data.ObjectID = enumId
								end
							end
						end
						if type(options) == "table" then
							if options.inverted ~= nil then
								data.Inverted = options.inverted
							end
							if options.favoritesOnly ~= nil then
								data.OnlyUseFavorites = options.favoritesOnly
							end
						end
						return data
					end

					local saveFile = "unlockall/config.json"
					local function saveConfig()
						if type(writefile) ~= "function" then
							return
						end
						pcall(function()
							local config = { equipped = {}, favorites = favorites }
							for weapon, cosmetics in pairs(equipped) do
								config.equipped[weapon] = {}
								for ct, cd in pairs(cosmetics) do
									if type(cd) == "table" and cd.Name then
										config.equipped[weapon][ct] = {
											name = cd.Name,
											seed = cd.Seed,
											inverted = cd.Inverted,
										}
									end
								end
							end
							if type(makefolder) == "function" then
								pcall(makefolder, "unlockall")
							end
							writefile(saveFile, HttpService:JSONEncode(config))
						end)
					end

					pcall(function()
						if type(readfile) == "function" and type(isfile) == "function" and isfile(saveFile) then
							local config = HttpService:JSONDecode(readfile(saveFile))
							if type(config) == "table" and type(config.equipped) == "table" then
								for weapon, cosmetics in pairs(config.equipped) do
									equipped[weapon] = {}
									if type(cosmetics) == "table" then
										for ct, cd in pairs(cosmetics) do
											if type(cd) == "table" then
												local cloned = cloneCosmetic(cd.name, ct, { inverted = cd.inverted })
												if cloned then
													if type(cd.seed) == "number" then
														cloned.Seed = cd.seed
													end
													equipped[weapon][ct] = cloned
												end
											end
										end
									end
								end
							end
							if type(config) == "table" and type(config.favorites) == "table" then
								favorites = config.favorites
								env._allSkinsFavorites = favorites
							end
						end
					end)

					CosmeticLibrary.OwnsCosmeticNormally = function()
						return true
					end
					CosmeticLibrary.OwnsCosmeticUniversally = function()
						return true
					end
					CosmeticLibrary.OwnsCosmeticForWeapon = function()
						return true
					end
					local originalOwnsCosmetic = CosmeticLibrary.OwnsCosmetic
					CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
						if type(name) == "string" and string.find(name, "MISSING_", 1, true) then
							return originalOwnsCosmetic(self, inventory, name, weapon)
						end
						return true
					end

					local originalGet = DataController.Get
					local inGet = false
					DataController.Get = function(self, key)
						if inGet then
							return originalGet(self, key)
						end
						inGet = true
						local okD, data = pcall(originalGet, self, key)
						inGet = false
						if not okD then
							return nil
						end
						if key == "CosmeticInventory" then
							local proxy = {}
							if type(data) == "table" then
								for k, v in pairs(data) do
									proxy[k] = v
								end
							end
							return setmetatable(proxy, {
								__index = function(_, k)
									if type(k) == "string" and k ~= "" and k ~= "Section" and not string.find(k, "MISSING_", 1, true) then
										return true
									end
									return nil
								end,
							})
						end
						if key == "FavoritedCosmetics" then
							local result = {}
							if type(data) == "table" then
								for k, v in pairs(data) do
									result[k] = v
								end
							end
							for weapon, favs in pairs(favorites) do
								result[weapon] = result[weapon] or {}
								if type(favs) == "table" then
									for name, isFav in pairs(favs) do
										result[weapon][name] = isFav
									end
								end
							end
							return result
						end
						return data
					end

					local originalGetWeaponData = DataController.GetWeaponData
					local inWD = false
					DataController.GetWeaponData = function(self, weaponName)
						if inWD then
							return originalGetWeaponData(self, weaponName)
						end
						inWD = true
						local okD, data = pcall(originalGetWeaponData, self, weaponName)
						inWD = false
						if not okD or type(data) ~= "table" then
							return data
						end
						local merged = {}
						for k, v in pairs(data) do
							merged[k] = v
						end
						if type(weaponName) == "string" then
							merged.Name = weaponName
							local eq = equipped[weaponName]
							if type(eq) == "table" then
								for ct, cd in pairs(eq) do
									if type(ct) == "string" and type(cd) == "table" and cd.Name then
										merged[ct] = cd
									end
								end
							end
						end
						return merged
					end

					-- Equip intercept only (no kick/shutdown/game-wide blocks)
					pcall(function()
						if not hookmetamethod or not newcclosure or env._allSkinsEquipHooked then
							return
						end
						local remotes = ReplicatedStorage:FindFirstChild("Remotes")
						local dataRemotes = remotes and remotes:FindFirstChild("Data")
						local equipRemote = dataRemotes and dataRemotes:FindFirstChild("EquipCosmetic")
						local favoriteRemote = dataRemotes and dataRemotes:FindFirstChild("FavoriteCosmetic")
						if not equipRemote then
							return
						end
						env._allSkinsEquipHooked = true
						local oldNamecall
						local busy = false
						oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
							if busy then
								return oldNamecall(self, ...)
							end
							if getnamecallmethod() ~= "FireServer" then
								return oldNamecall(self, ...)
							end
							if self ~= equipRemote and self ~= favoriteRemote then
								return oldNamecall(self, ...)
							end
							busy = true
							local args = { ... }
							if self == equipRemote then
								local weaponName, cosmeticType, cosmeticName, options = args[1], args[2], args[3], args[4]
								if type(options) ~= "table" then
									options = {}
								end
								if type(weaponName) == "string" and type(cosmeticType) == "string" then
									if type(cosmeticName) == "string" and cosmeticName ~= "" and cosmeticName ~= "None" then
										local trulyOwned = false
										pcall(function()
											local inv = originalGet(DataController, "CosmeticInventory")
											if type(inv) == "table" and rawget(inv, cosmeticName) then
												trulyOwned = true
											end
										end)
										equipped[weaponName] = equipped[weaponName] or {}
										local cloned = cloneCosmetic(cosmeticName, cosmeticType, {
											inverted = options.IsInverted,
											favoritesOnly = options.OnlyUseFavorites,
										})
										if cloned then
											equipped[weaponName][cosmeticType] = cloned
										end
										task.defer(function()
											pcall(function()
												if DataController.CurrentData and DataController.CurrentData.Replicate then
													DataController.CurrentData:Replicate("WeaponInventory")
												end
											end)
											saveConfig()
										end)
										if trulyOwned then
											local r = oldNamecall(self, ...)
											busy = false
											return r
										end
										busy = false
										return
									else
										if equipped[weaponName] then
											equipped[weaponName][cosmeticType] = nil
											if not next(equipped[weaponName]) then
												equipped[weaponName] = nil
											end
										end
										task.defer(saveConfig)
									end
								end
							elseif self == favoriteRemote then
								local w, n, fav = args[1], args[2], args[3]
								if type(w) == "string" and type(n) == "string" then
									favorites[w] = favorites[w] or {}
									favorites[w][n] = fav or nil
									env._allSkinsFavorites = favorites
									task.defer(saveConfig)
									busy = false
									return
								end
							end
							local r = oldNamecall(self, ...)
							busy = false
							return r
						end))
					end)

					-- ViewModel apply
					pcall(function()
						if env._allSkinsVMHooked then
							return
						end
						local mods = playerScripts:FindFirstChild("Modules")
						local crc = mods and mods:FindFirstChild("ClientReplicatedClasses")
						local cf = crc and crc:FindFirstChild("ClientFighter")
						local clientItemPath = cf and cf:FindFirstChild("ClientItem")
						if not clientItemPath then
							return
						end
						local ClientItem = require(clientItemPath)
						if type(ClientItem) ~= "table" or type(ClientItem._CreateViewModel) ~= "function" then
							return
						end
						env._allSkinsVMHooked = true
						local originalCreateViewModel = ClientItem._CreateViewModel
						ClientItem._CreateViewModel = function(self, viewmodelRef)
							pcall(function()
								if type(self) ~= "table" or type(viewmodelRef) ~= "table" then
									return
								end
								local weaponName = self.Name
								local weaponPlayer = self.ClientFighter and self.ClientFighter.Player
								if weaponPlayer ~= lp or type(weaponName) ~= "string" then
									return
								end
								local eq = equipped[weaponName]
								if type(eq) ~= "table" or type(eq.Skin) ~= "table" then
									return
								end
								local skin = eq.Skin
								local dataKey, skinKey, nameKey
								pcall(function()
									dataKey = self:ToEnum("Data")
									skinKey = self:ToEnum("Skin")
									nameKey = self:ToEnum("Name")
								end)
								if dataKey ~= nil and type(viewmodelRef[dataKey]) == "table" then
									if skinKey ~= nil then
										viewmodelRef[dataKey][skinKey] = skin
									end
									if nameKey ~= nil and type(skin.Name) == "string" then
										viewmodelRef[dataKey][nameKey] = skin.Name
									end
								elseif type(viewmodelRef.Data) == "table" then
									viewmodelRef.Data.Skin = skin
									if type(skin.Name) == "string" then
										viewmodelRef.Data.Name = skin.Name
									end
								end
							end)
							return originalCreateViewModel(self, viewmodelRef)
						end

						local viewModelModule = clientItemPath:FindFirstChild("ClientViewModel")
						if viewModelModule then
							local ClientViewModel = require(viewModelModule)
							if type(ClientViewModel) == "table" and type(ClientViewModel.new) == "function" then
								local originalNew = ClientViewModel.new
								ClientViewModel.new = function(replicatedData, clientItem)
									pcall(function()
										if type(replicatedData) ~= "table" or type(clientItem) ~= "table" then
											return
										end
										local weaponPlayer = clientItem.ClientFighter and clientItem.ClientFighter.Player
										local weaponName = clientItem.Name
										if weaponPlayer ~= lp or type(weaponName) ~= "string" then
											return
										end
										local eq = equipped[weaponName]
										if type(eq) ~= "table" or type(eq.Skin) ~= "table" then
											return
										end
										local ReplicatedClass = require(modules.ReplicatedClass)
										local dataKey = ReplicatedClass:ToEnum("Data")
										local skinKey = ReplicatedClass:ToEnum("Skin")
										if dataKey == nil or skinKey == nil then
											return
										end
										if type(replicatedData[dataKey]) ~= "table" then
											replicatedData[dataKey] = {}
										end
										replicatedData[dataKey][skinKey] = eq.Skin
									end)
									return originalNew(replicatedData, clientItem)
								end
							end
						end
					end)

					env._allSkinsLoaded = true
				end)
				env._allSkinsLoading = false
				return ok, err
			end

