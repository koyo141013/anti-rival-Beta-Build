					local CosmeticLibrary = require(modules:WaitForChild("CosmeticLibrary", 8))
					local ItemLibrary = require(modules:WaitForChild("ItemLibrary", 8))
					local DataController = require(controllers:WaitForChild("PlayerDataController", 8))

					local equipped = env._allSkinsEquipped or {}
					env._allSkinsEquipped = equipped
