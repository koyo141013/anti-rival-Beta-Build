			local function handleInputBegan(input, gameProcessed)
				if input.UserInputType == Enum.UserInputType.Keyboard then
					if listeningKey then
						if input.KeyCode ~= Enum.KeyCode.Unknown then
							keybinds[listeningKey] = input.KeyCode
							local keyNameStr = tostring(input.KeyCode.Name)
							updateKeybindUI(listeningKey, keyNameStr)

							if listeningKey == "randomTp" then bindRandomTpBtn.Text = keyNameStr
							elseif listeningKey == "autoTp" then bindAutoTpBtn.Text = keyNameStr
							elseif listeningKey == "orbit" then bindOrbitBtn.Text = keyNameStr
							elseif listeningKey == "fight" then bindFightBtn.Text = keyNameStr
							elseif listeningKey == "noclip" then bindNoclipBtn.Text = keyNameStr
							elseif listeningKey == "esp" then bindEspBtn.Text = keyNameStr
							end
						end
						listeningKey = nil
					elseif not gameProcessed then
						if keybinds.randomTp ~= Enum.KeyCode.Unknown and input.KeyCode == keybinds.randomTp then
							pcall(function()
								local _, myRoot = getSafeParts()
								if not myRoot then return end
								local validTargets = {}
								for _, p in ipairs(Players:GetPlayers()) do
									if p ~= player then
										local char = p.Character
										if char then
											local hum = char:FindFirstChildOfClass("Humanoid")
											local head = char:FindFirstChild("Head")
											if hum and hum.Health > 0 and head then table.insert(validTargets, head) end
										end
									end
								end
								if #validTargets > 0 then
									local randomHead = validTargets[math.random(1, #validTargets)]
									local randomAngle = math.random() * math.pi * 2
									local offsetDir = Vector3.new(math.cos(randomAngle), 0, math.sin(randomAngle))
									myRoot.CFrame = CFrame.new(randomHead.Position + (offsetDir * 5), randomHead.Position)
								end
							end)
						elseif keybinds.autoTp ~= Enum.KeyCode.Unknown and input.KeyCode == keybinds.autoTp then
							S.teleporterOn = not S.teleporterOn
							setToggle(teleporterButton, S.teleporterOn, "auto 50k tp (every 1s)")
						elseif keybinds.orbit ~= Enum.KeyCode.Unknown and input.KeyCode == keybinds.orbit then
							S.orbitOn = not S.orbitOn
